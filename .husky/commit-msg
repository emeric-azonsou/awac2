#!/bin/sh
# Conventional Commits: <type>(<scope>)!: <subject>
PATTERN='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .{1,100}$'

FIRST_LINE=$(head -n 1 "$1")

# Merge and revert commits generated by git keep their own format.
case "$FIRST_LINE" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if ! printf '%s' "$FIRST_LINE" | grep -Eq "$PATTERN"; then
  echo "commit-msg refuse: message hors Conventional Commits." >&2
  echo "  recu   : $FIRST_LINE" >&2
  echo "  attendu: feat(vote): ajoute le compte a rebours" >&2
  exit 1
fi
